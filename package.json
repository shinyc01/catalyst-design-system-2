{
  "name": "catalyst-ds-2",
  "private": true,
  "version": "2.0.7",
  "description": "Catalyst Design System 2.0: a separate copy of the IFS DS kit (polish branch values) with user-selectable density (Spacious / Comfortable / Compact).",
  "type": "module",
  "scripts": {
    "storybook": "node tools/gen-stories.mjs && storybook dev -p 6006",
    "stories": "node tools/gen-stories.mjs",
    "build": "node build.mjs",
    "build-storybook": "node tools/gen-stories.mjs && storybook build -o dist/storybook --quiet",
    "release": "node tools/gen-stories.mjs && node build.mjs && node tools/gen-api.mjs && node tools/gen-examples.mjs && npm run demo && storybook build -o dist/storybook --quiet",
    "demo": "bash demo/build.sh"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-designs": "8.2.1",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/manager-api": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/theming": "8.6.14",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.25.0",
    "storybook": "8.6.14",
    "vite": "6.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shinyc01/catalyst-design-system-2.git"
  },
  "allowScripts": {
    "esbuild@0.25.0": true
  }
}
